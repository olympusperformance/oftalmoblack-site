{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/agendamento/",
      "permanent": true
    },
    {
      "source": "/agendamento/oswaldofrazao/",
      "destination": "/agendamento/",
      "permanent": true
    },
    {
      "source": "/agendamento/oswaldofrazao/:path*",
      "destination": "/agendamento/:path*",
      "permanent": true
    }
  ]
}
