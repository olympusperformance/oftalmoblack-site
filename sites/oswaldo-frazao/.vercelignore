# Exact file allowlist evaluated from the Git repository root.
# CLI deployments require a separate staging folder containing only approved files.
# Bare and trailing-slash directory names support the CLI recursive walker.
*
!/sites
!/sites/
/sites/*
!/sites/oswaldo-frazao
!/sites/oswaldo-frazao/
/sites/oswaldo-frazao/*
!/sites/oswaldo-frazao/public
!/sites/oswaldo-frazao/public/
/sites/oswaldo-frazao/public/*
!/sites/oswaldo-frazao/public/agendamento
!/sites/oswaldo-frazao/public/agendamento/
/sites/oswaldo-frazao/public/agendamento/*
!/sites/oswaldo-frazao/public/agendamento/index.html
!/sites/oswaldo-frazao/public/agendamento/assets
!/sites/oswaldo-frazao/public/agendamento/assets/
/sites/oswaldo-frazao/public/agendamento/assets/*
!/sites/oswaldo-frazao/public/agendamento/assets/dr-oswaldo-retrato.jpg
!/sites/oswaldo-frazao/vercel.json
